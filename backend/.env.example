# Copy to .env and fill in. NEVER commit .env.

# PostgreSQL connection string (use the one your host gives you)
DATABASE_URL=postgresql://dairy:change-me@localhost:5432/dairy_db

# Long random string. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=replace-with-a-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=720

# Comma-separated list of frontend URLs allowed to call the API
CORS_ORIGINS=http://localhost:5173

# "Today" in reports is calculated in this timezone
APP_TIMEZONE=Asia/Kolkata

# How many minutes after saving a sale staff can still press "Undo"
UNDO_WINDOW_MINUTES=5

# First admin account (used only by: python -m src.seed)
ADMIN_FULL_NAME=Dairy Owner
ADMIN_EMAIL=owner@example.com
ADMIN_PASSWORD=change-this-password
